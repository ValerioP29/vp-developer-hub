APP_NAME="VP Developer Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vp_hub
DB_USERNAME=vp_hub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Set SMTP before inviting real users; log is for local development only.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hub@example.test"
MAIL_FROM_NAME="VP Developer Hub"
HUB_EMAIL_NOTIFICATIONS=false
HUB_UPLOAD_MAX_KB=10240
HUB_AUDIT_RETENTION_DAYS=730
HUB_SESSION_RETENTION_DAYS=7
# Exact proxy IPs or CIDRs of the dedicated Coolify network; never trust arbitrary clients.
TRUSTED_PROXIES=
# Only web may run migrations, explicitly enabled per deployment.
RUN_MIGRATIONS=false
